%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 50, "padding": 12}, "themeVariables": {
  "fontFamily": "Helvetica Neue, Arial, sans-serif", "fontSize": "15px",
  "primaryColor": "#f3ebd9", "primaryTextColor": "#15201b", "primaryBorderColor": "#cdbf9f",
  "lineColor": "#c9a24b", "clusterBkg": "#082a21", "clusterBorder": "#1c5443", "titleColor": "#f3ebd9",
